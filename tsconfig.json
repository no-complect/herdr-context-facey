{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "mods/herdr-context-facey",
    "paths": {
      "gpui-kit": ["./types/gpui-kit.d.ts"],
      "gpui-base": ["./types/gpui-base.d.ts"],
      "herdr": ["./types/herdr.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
