{
  "name": "herdr-context-facey",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A native Herdr context inspector for local Codex, Claude Code, Grok Build and Antigravity CLI sessions",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json && prettier --write mods/herdr-context-facey/*.js --ignore-path .gitignore",
    "build:watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p tsconfig.tools.json",
    "typecheck:herdr": "node --experimental-strip-types scripts/check-host-types.ts",
    "pretest": "npm run build && npm run typecheck",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  }
}
